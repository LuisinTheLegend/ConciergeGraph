# =============================================================================
# Grafo Concierge v3.8.0 - Environment Variables Configuration (.env.example)
# =============================================================================
# Copy this file to '.env' and adjust the values for your local environment:
# cp .env.example .env
# =============================================================================

# -----------------------------------------------------------------------------
# 1. LLM & COGNITIVE SUMMARIES (Zoom Gear L0/L1/L2 & Critical Reviewer)
# -----------------------------------------------------------------------------
# API key for Google Gemini or compatible provider (OpenAI / OpenRouter)
# (You may also define GEMINI_API_KEY)
GRAFO_LLM_API_KEY=your_api_key_here_without_quotes
GEMINI_API_KEY=your_api_key_here_without_quotes

# LLM model for AST summarization and cognitive reasoning
# Recommended models: gemini-2.0-flash, gemini-1.5-flash, gpt-4o-mini
GRAFO_LLM_MODEL=gemini-2.0-flash

# Custom base URL for alternative LLM providers (Optional)
# Useful for OpenRouter, DeepSeek, Groq, Ollama, local vLLM, etc.
# OpenRouter example: https://openrouter.ai/api/v1
# Local Ollama example: http://localhost:11434/v1
GRAFO_LLM_BASE_URL=

# -----------------------------------------------------------------------------
# 2. LOCAL STORAGE & DATABASES (SQLite WAL & Embeddings)
# -----------------------------------------------------------------------------
# Path to SQLite relational database (Topology, AST, and Memory Graph)
GRAFO_DB_PATH=./data/concierge.db

# Local persistence directory and collection name for ChromaDB
GRAFO_CHROMA_PATH=./data/chroma
GRAFO_CHROMA_COLLECTION=grafo_concierge

# Local embedding model (HuggingFace Sentence-Transformers)
GRAFO_EMBEDDING_MODEL=all-MiniLM-L6-v2

# Lightweight mode (Optional - saves RAM by disabling the vector engine
# and using FTS5 / BM25 for hybrid search)
GRAFO_LIGHTWEIGHT_MODE=false

# -----------------------------------------------------------------------------
# 3. VECTOR BACKEND ('chroma' or 'qdrant')
# -----------------------------------------------------------------------------
GRAFO_VECTOR_BACKEND=chroma

# Qdrant cluster settings (required if GRAFO_VECTOR_BACKEND=qdrant)
GRAFO_QDRANT_URL=http://localhost:6333
GRAFO_QDRANT_API_KEY=

# -----------------------------------------------------------------------------
# 4. BACKGROUND JANITOR (Lifecycle & Autonomous Maintenance)
# -----------------------------------------------------------------------------
# Interval in seconds between background Janitor cycles (default: 300s = 5min)
GRAFO_JANITOR_INTERVAL=300

# Project UUID for continuous background maintenance (optional)
# Leave empty for idle mode or manual on-demand execution
GRAFO_JANITOR_PROJECT=

# -----------------------------------------------------------------------------
# 5. LOGGING & DIAGNOSTICS
# -----------------------------------------------------------------------------
# Available log levels: DEBUG, INFO, WARNING, ERROR, CRITICAL
GRAFO_LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# 6. MCP SERVER & COMMUNICATION TRANSPORT
# -----------------------------------------------------------------------------
# Transport type for MCP clients / Web Frontend:
# - 'stdio' : default for local CLI agent integration (Claude Desktop, Cursor, etc.)
# - 'sse'   : Server-Sent Events (used by Web Dashboard / Next.js)
GRAFO_TRANSPORT=sse

# Host and Port for MCP server binding
GRAFO_HOST=127.0.0.1
GRAFO_PORT=7077

# Server Binding Address (Local-First Security)
# - 127.0.0.1 : secure default (listens exclusively to local loopback calls)
# - 0.0.0.0   : exposes to external network or private mesh (e.g. Tailscale / VPN)
CONCIERGE_BIND_ADDRESS=127.0.0.1

# -----------------------------------------------------------------------------
# 7. SECURITY, REMOTE AUTHENTICATION & CORS
# -----------------------------------------------------------------------------
# Optional Bearer token authentication for SSE requests (recommended for VPS)
# When set, requests require 'Authorization: Bearer <key>' or '?token=<key>'
GRAFO_API_KEY=

# Allowed CORS origins (comma-separated). Default: *
GRAFO_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://127.0.0.1:7077
