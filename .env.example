# Grafo Concierge v3.8.0 - Environment Variables Example
# Copie este arquivo para um novo arquivo chamado '.env' e preencha os valores.

# Chave de API do Google Gemini ou OpenAI (Necessária para resumos L1/L2 e Revisor Crítico)
GRAFO_LLM_API_KEY=sua_chave_aqui_sem_aspas

# Modelo LLM a ser utilizado (padrão: gemini-2.0-flash)
GRAFO_LLM_MODEL=gemini-2.0-flash

# URL Base customizada para o provedor de LLM (Opcional - útil para OpenRouter, DeepSeek, Groq, Ollama, etc.)
# GRAFO_LLM_BASE_URL=https://openrouter.ai/api/v1

# Caminhos de armazenamento de dados locais (SQLite e ChromaDB)
GRAFO_DB_PATH=./data/concierge.db
GRAFO_CHROMA_PATH=./data/chroma
GRAFO_CHROMA_COLLECTION=grafo_concierge

# Nível de Log (DEBUG, INFO, WARNING, ERROR)
GRAFO_LOG_LEVEL=INFO

# UUID do Projeto para o Janitor atuar automaticamente (Opcional)
GRAFO_JANITOR_PROJECT=

# Modo Lightweight (Opcional - economiza RAM desativando o motor vetorial local/remoto e usando FTS5 como fallback)
GRAFO_LIGHTWEIGHT_MODE=false

# Backend Vetorial ('chroma' ou 'qdrant')
GRAFO_VECTOR_BACKEND=chroma

# URL do Cluster Qdrant (obrigatório se GRAFO_VECTOR_BACKEND=qdrant)
GRAFO_QDRANT_URL=http://localhost:6333

# Chave de API de autenticação do Qdrant (opcional - necessário para Qdrant Cloud)
# GRAFO_QDRANT_API_KEY=sua_chave_do_qdrant_aqui

# Configurações do Servidor MCP (Host & Porta)
GRAFO_HOST=127.0.0.1
GRAFO_PORT=8000

# Autenticação por Chave de API para o Servidor MCP (Opcional - Útil para implantações em VPS pública/privada)
# GRAFO_API_KEY=sua_chave_de_acesso_remoto_aqui

# Origens CORS permitidas (Opcional - separadas por vírgula. Padrão: *)
# GRAFO_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:8000

