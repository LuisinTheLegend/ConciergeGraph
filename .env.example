# =============================================================================
# Grafo Concierge v3.8.0 - Environment Variables Configuration (.env.example)
# =============================================================================
# Copie este arquivo para '.env' e configure os valores conforme seu ambiente:
# cp .env.example .env
# =============================================================================

# -----------------------------------------------------------------------------
# 1. LLM & RESUMOS COGNITIVOS (Zoom Gear L0/L1/L2 & Revisor Crítico)
# -----------------------------------------------------------------------------
# Chave de API do Google Gemini ou provedor compatível OpenAI / OpenRouter
# (Você também pode definir GEMINI_API_KEY)
GRAFO_LLM_API_KEY=sua_chave_aqui_sem_aspas
GEMINI_API_KEY=sua_chave_aqui_sem_aspas

# Modelo LLM a ser utilizado para resumos e raciocínio cognitivo
# Modelos recomendados: gemini-2.0-flash, gemini-1.5-flash, gpt-4o-mini
GRAFO_LLM_MODEL=gemini-2.0-flash

# URL Base customizada para o provedor de LLM (Opcional)
# Útil para OpenRouter, DeepSeek, Groq, Ollama, vLLM local, etc.
# Exemplo OpenRouter: https://openrouter.ai/api/v1
# Exemplo Ollama local: http://localhost:11434/v1
GRAFO_LLM_BASE_URL=

# -----------------------------------------------------------------------------
# 2. ARMAZENAMENTO LOCAL & BANCO DE DADOS (SQLite WAL & Embeddings)
# -----------------------------------------------------------------------------
# Caminho do banco de dados relacional SQLite (Topologia, AST e Memória)
GRAFO_DB_PATH=./data/concierge.db

# Caminho de persistência local para o ChromaDB
GRAFO_CHROMA_PATH=./data/chroma
GRAFO_CHROMA_COLLECTION=grafo_concierge

# Modelo local de embeddings (HuggingFace Sentence-Transformers)
GRAFO_EMBEDDING_MODEL=all-MiniLM-L6-v2

# Modo Lightweight (Opcional - economiza RAM desativando o motor vetorial
# e utilizando FTS5 / BM25 como mecanismo de busca híbrida)
GRAFO_LIGHTWEIGHT_MODE=false

# -----------------------------------------------------------------------------
# 3. BACKEND VETORIAL ('chroma' ou 'qdrant')
# -----------------------------------------------------------------------------
GRAFO_VECTOR_BACKEND=chroma

# Configurações do Qdrant (obrigatório caso GRAFO_VECTOR_BACKEND=qdrant)
GRAFO_QDRANT_URL=http://localhost:6333
GRAFO_QDRANT_API_KEY=

# -----------------------------------------------------------------------------
# 4. BACKGROUND JANITOR (Ciclo de Vida & Limpeza Autônoma)
# -----------------------------------------------------------------------------
# Intervalo em segundos entre execuções do Janitor em background (padrão: 300s = 5min)
GRAFO_JANITOR_INTERVAL=300

# UUID de um projeto específico para monitoramento contínuo (opcional)
# Deixe em branco para modo idle ou controle manual
GRAFO_JANITOR_PROJECT=

# -----------------------------------------------------------------------------
# 5. DIAGNÓSTICO & LOGS
# -----------------------------------------------------------------------------
# Níveis disponíveis: DEBUG, INFO, WARNING, ERROR, CRITICAL
GRAFO_LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# 6. SERVIDOR MCP & TRANSPORTE DE COMUNICAÇÃO
# -----------------------------------------------------------------------------
# Tipo de transporte para clientes MCP / Frontend:
# - 'stdio' : padrão para integração local com Claude Desktop, Cursor, etc.
# - 'sse'   : Server-Sent Events (usado pelo Dashboard Web / Next.js)
GRAFO_TRANSPORT=sse

# Host e Porta de escuta do servidor MCP
GRAFO_HOST=127.0.0.1
GRAFO_PORT=7077

# Endereço de Binding do Servidor (Segurança Local-First)
# - 127.0.0.1 : seguro por padrão (escuta apenas chamadas locais da própria máquina)
# - 0.0.0.0   : expõe para rede externa ou rede privada (ex: Tailscale / VPN)
CONCIERGE_BIND_ADDRESS=127.0.0.1

# -----------------------------------------------------------------------------
# 7. SEGURANÇA, AUTENTICAÇÃO REMOTA & CORS
# -----------------------------------------------------------------------------
# Autenticação por token Bearer para requisições SSE (Opcional - útil em VPS/remoto)
# Se definido, requisições exigirão 'Authorization: Bearer <chave>' ou '?token=<chave>'
GRAFO_API_KEY=

# Origens CORS permitidas (separadas por vírgula). Padrão: *
GRAFO_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://127.0.0.1:7077
