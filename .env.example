# Grafo Concierge v3.8.0 - Environment Variables Example
# Copie este arquivo para um novo arquivo chamado '.env' e preencha os valores.

# Chave de API do Google Gemini ou OpenAI (Necessária para resumos L1/L2)
GRAFO_LLM_API_KEY=sua_chave_aqui_sem_aspas

# Nível de Log (DEBUG, INFO, WARNING, ERROR)
GRAFO_LOG_LEVEL=INFO

# UUID do Projeto para o Janitor atuar automaticamente (Opcional)
GRAFO_JANITOR_PROJECT=

# Caminho para o banco de dados (Opcional - padrão é ./data/concierge.db)
# GRAFO_DB_PATH=./data/concierge.db
